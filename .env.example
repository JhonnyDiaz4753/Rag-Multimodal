# === Aplicación ===
APP_NAME=rag-multimodal
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# === Logging ===
# json: ideal para producción y agregadores de logs.
# console: lectura cómoda durante el desarrollo local.
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Almacenamiento ===
# En Docker: /data (volumen app_data). En local: ./data
DATA_DIR=/data

# === Redis (broker y backend de Celery) ===
# Docker Compose: redis://redis:6379/0
# Local:          redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# === Qdrant ===
# Docker Compose: http://qdrant:6333
# Local:          http://localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=manuals
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# === Ollama ===
# Docker Compose: http://ollama:11434
# Local:          http://localhost:11434
# En Compose, Ollama es opcional: docker compose --profile ollama up --build
OLLAMA_BASE_URL=http://ollama:11434

# === Modelos ===
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=bge-m3
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=1024
VISION_MODEL=qwen2.5vl:7b
ENABLE_IMAGE_CAPTIONING=false

# === Proveedor OpenAI (opcional) ===
# Solo se usa si LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
